generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          String         @default("PLAYER")
  status        String         @default("ACTIVE")
  kycStatus     String         @default("UNVERIFIED")
  currency      String         @default("USD")
  locale        String         @default("en")
  affiliateCode String         @unique @default(cuid())
  referredBy    String?
  excludedUntil DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  refreshTokens RefreshToken[]
  gameSessions  GameSession[]
  depositLimit  DepositLimit?
  kycDocuments  KycDocument[]
  transactions  Transaction[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model KycDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType   String
  fileRef   String
  status    String   @default("PENDING")
  note      String?
  createdAt DateTime @default(now())

  @@index([status])
}

model DepositLimit {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLimitCents   Int
  weeklyLimitCents  Int
  monthlyLimitCents Int
  updatedAt         DateTime @updatedAt
}

model Account {
  id           String        @id @default(cuid())
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  kind         String
  currency     String
  balanceCents Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ledgerEntries LedgerEntry[]

  @@unique([userId, kind, currency])
}

model Transaction {
  id             String        @id @default(cuid())
  type           String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  reference      String?
  providerRoundId String?
  gameId         String?
  game           Game?         @relation(fields: [gameId], references: [id])
  amountCents    Int
  meta           String?
  createdAt      DateTime      @default(now())
  entries        LedgerEntry[]

  @@unique([providerRoundId, type])
  @@index([userId, createdAt])
}

model LedgerEntry {
  id                String      @id @default(cuid())
  transactionId     String
  transaction       Transaction @relation(fields: [transactionId], references: [id])
  accountId         String
  account           Account     @relation(fields: [accountId], references: [id])
  direction         String
  amountCents       Int
  balanceAfterCents Int
  createdAt         DateTime    @default(now())

  @@index([accountId, createdAt])
}

model Game {
  id             String        @id @default(cuid())
  providerCode   String
  providerGameId String
  name           String
  category       String
  thumbnail      String
  rtp            Float?
  active         Boolean       @default(true)
  sessions       GameSession[]
  transactions   Transaction[]

  @@unique([providerCode, providerGameId])
}

model GameSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  gameId       String
  game         Game      @relation(fields: [gameId], references: [id])
  sessionToken String    @unique
  launchUrl    String
  currency     String
  locale       String
  status       String    @default("OPEN")
  createdAt    DateTime  @default(now())
  closedAt     DateTime?

  @@index([userId, status])
}
